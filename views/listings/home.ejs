<% layout("/layouts/boilerplate") -%>
<style>
  .welcome {
    border: none;
    border-radius: 20px;
    min-height: 15rem;
    padding: 2rem;
    background: white;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  }

  .welcome h1 {
    text-align: center;
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .box {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .box div {
    border: 1px solid #222;
    display: flex;
    justify-content: center;
    align-items: center;

    height: 3rem;
    width: 40%;

    border-radius: 8px;
    transition: 0.2s ease;
  }

  .box div:hover {
    background-color: #222;
    transform: translateY(-2px);
  }

  .box div:hover a {
    color: white;
  }

  .a {
    text-decoration: none;
    color: #222;
    font-weight: 500;
    width: 100%;
    height: 100%;

    display: flex;
    justify-content: center;
    align-items: center;
  }

  .stay {
    text-align: center;
    margin-top: 1.5rem;
  }

  .stay a {
    color: #555;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .stay a:hover {
    text-decoration: underline;
    color: #222;
  }
</style>


<div class="welcome col-4 offset-4 mt-5">
  <h1>Welcome to Airbnb</h1>
  <div class="box mt-4">
    <div><a class="a" href="/login">Login</a></div>
    <div><a class="a" href="/signup">Sign up</a></div>
  </div>
  <div class="stay mt-4"><a class="a" href="/listings">Stay signed out</a></div>
</div>